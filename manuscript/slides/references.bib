@article{xiaAdaptiveEstimationDimension2002,
  title = {An {{Adaptive Estimation}} of {{Dimension Reduction Space}}},
  author = {Xia, Yingcun and Tong, Howell and Li, W. K. and Zhu, Li-Xing},
  year = 2002,
